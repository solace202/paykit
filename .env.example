# --- Offline demo (default): nothing to set. stripe-mock + simulated webhooks. ---

# --- Real Stripe test mode ---
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...        # printed by `stripe listen`
# STRIPE_API_BASE=                       # empty = api.stripe.com
# DEMO_MODE=false

# Admin / API basic auth
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional: POST every customer notification (outbox) as JSON to this URL (n8n, Zapier, your mailer)
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/paykit

# Dunning grace period before paid features are paused while Stripe keeps retrying
# DUNNING_GRACE_PERIOD=7d
